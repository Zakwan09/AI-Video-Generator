# PostgreSQL connection string (async driver)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/video_generator

# Free-tier AI video generation provider keys.
# The app tries them in this priority order: Fal AI -> Replicate -> HuggingFace.
# You only need to fill in at least one for the app to work.

# Get a free key at https://fal.ai
FAL_API_KEY=

# Get free trial credits at https://replicate.com
REPLICATE_API_TOKEN=

# Get a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=

# Optional overrides
MAX_HISTORY_RECORDS=5
GENERATION_TIMEOUT_SECONDS=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
